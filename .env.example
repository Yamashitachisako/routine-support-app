DATABASE_URL=postgresql://postgres:postgres@localhost:5432/routine_support_app
PORT=5000

# Google Sheets（本番: 環境変数 / ローカル: credentials/service-account.json も可）
GOOGLE_SHEETS_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY: JSONの private_key を1行にし、改行を \n に置換
# Renderでは引用符で囲んでも囲まなくても可（例: -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n）
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
